
{
  "expo": {
    "name": "FlowMint",
    "slug": "flowmint",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "./plugins/withAndroidAllowBackup"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050D12"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00C896"
      },
      "package": "com.jforests.flowmint",
      "versionCode": 3,
      "minSdkVersion": 24,
      "permissions": [
        "READ_SMS",
        "RECEIVE_SMS"
      ],
      "runtimeVersion": "1.0.0"
    },
    "owner": "jforests",
    "extra": {
      "eas": {
        "projectId": "6d2886c8-84a7-448d-b93f-182ecea9261a"
      }
    },
    "ios": {
      "bundleIdentifier": "com.flowmint.app",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/6d2886c8-84a7-448d-b93f-182ecea9261a"
    }
  }
}